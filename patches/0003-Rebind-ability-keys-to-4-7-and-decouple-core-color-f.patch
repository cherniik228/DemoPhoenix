Date: Mon, 26 Oct 2026 20:01:43 +0000
Subject: [PATCH 3/3] Rebind ability keys to 4-7 and decouple core color from
 categories

- PlayerCore.cs: Replaced per-ability key binding with category-based activation using keys 4 (Combat), 5 (BuffDebuff), 6 (Regeneration), and 7 (Ultimate); added console logging for ability category usage and failure reasons.
- CoreVisual.cs: Added `driveColorFromHeat` toggle to make core color reflect only current heat level (blue-to-red gradient) instead of ability category; removed logic that set color based on specific ability types.
- CoreOverheatSystem.cs: Exposed `OverheatThreshold` property to support visual heat mapping in CoreVisual.
---
 .../magic/core/CoreOverheatSystem.cs          |  1 +
 .../PlayerLogic/magic/core/CoreVisual.cs      | 22 ++++++
 .../PlayerLogic/magic/core/PlayerCore.cs      | 71 +++++++++++++++----
 3 files changed, 79 insertions(+), 15 deletions(-)

diff --git a/Assets/Scripts/PlayerLogic/magic/core/CoreOverheatSystem.cs b/Assets/Scripts/PlayerLogic/magic/core/CoreOverheatSystem.cs
index db66b5f..a34f5b3 100644
--- a/Assets/Scripts/PlayerLogic/magic/core/CoreOverheatSystem.cs
+++ b/Assets/Scripts/PlayerLogic/magic/core/CoreOverheatSystem.cs
@@ -28,6 +28,7 @@ public class CoreOverheatSystem : MonoBehaviour
 
     public float CurrentHeat => currentHeat;
     public float HeatPercent => maxHeat > 0 ? currentHeat / maxHeat : 0;
+    public float OverheatThreshold => overheatThreshold;
     public bool IsOverheated => isOverheated;
     public float MaxHeat => maxHeat;
     public float CoolingRate => coolingRate;
diff --git a/Assets/Scripts/PlayerLogic/magic/core/CoreVisual.cs b/Assets/Scripts/PlayerLogic/magic/core/CoreVisual.cs
index 77ceb81..5e8baa5 100644
