+                ActivateAbility(ability);
+                Debug.Log($"[СПОСОБНОСТЬ] Категория «{GetCategoryName(type)}» активирована: {ability.abilityName}");
+                return;
+            }
+            else
             {
-                UseAbility(i);
+                string reason = IsOverheated ? "ядро перегрето"
